<screen>
	<styles>
		<style
			name="card"
			bg_color="0x0A0A0A"
			border_width="2"
			radius="8"
			pad_all="0"
		/>
		<style name="title" text_color="0xAAAAAA" text_font="body_sm" />
		<style name="value" text_color="0xFFFFFF" text_font="title_large" />
		<style name="unit" text_color="0x888888" text_font="body_sm" />
		<style name="bar_bg" bg_color="0x222222" bg_opa="255" />
		<style name="bar_fill" bg_color="0x00FF66" bg_opa="255" />
	</styles>

	<view style_bg_color="0x000000" style_pad_all="0" scrollable="false">
		<!-- RPM shift bar across the top -->
		<lv_bar
			name="rpm_bar"
			x="6"
			y="4"
			width="468"
			height="12"
			min_value="0"
			max_value="8000"
			value="0"
			style_radius="6"
			bind_checked="rpm"
		>
			<style name="bar_bg" selector="main" />
			<style name="bar_fill" selector="indicator" />
		</lv_bar>

		<!-- LEFT: coolant + oil pressure -->
		<lv_obj
			x="6"
			y="22"
			width="142"
			height="94"
			scrollable="false"
			style_border_color="0x00B4FF"
		>
			<style name="card" />
			<lv_label text="COOLANT" align="top_mid" y="6">
				<style name="title" />
			</lv_label>
			<lv_label
				name="coolant_val"
				text="82"
				bind_text="coolant"
				align="center"
			>
				<style name="value" />
			</lv_label>
			<lv_label text="&#176;C" align="bottom_mid" y="-6">
				<style name="unit" />
			</lv_label>
		</lv_obj>

		<lv_obj
			x="6"
			y="124"
			width="142"
			height="94"
			scrollable="false"
			style_border_color="0xFFA000"
		>
			<style name="card" />
			<lv_label text="OIL PRESSURE" align="top_mid" y="6">
				<style name="title" />
			</lv_label>
			<lv_label
				name="oil_press_val"
				text="4.2"
				bind_text="oil_press"
				align="center"
			>
				<style name="value" />
			</lv_label>
			<lv_label text="bar" align="bottom_mid" y="-6">
				<style name="unit" />
			</lv_label>
		</lv_obj>

		<!-- CENTER: gear, rpm, speed -->
		<lv_obj
			x="154"
			y="22"
			width="172"
			height="196"
			scrollable="false"
			style_border_color="0xFFFFFF"
		>
			<style name="card" />
			<lv_label text="RPM" align="top_left" x="8" y="6">
				<style name="title" />
			</lv_label>
			<lv_label
				name="rpm_val"
				bind_text="rpm"
				align="top_left"
				x="8"
				y="22"
				style_text_color="0xFFFFFF"
				style_text_font="body_lg"
			/>
			<lv_label text="SPEED" align="top_right" x="-8" y="6">
				<style name="title" />
			</lv_label>
			<lv_label
				name="speed_val"
				bind_text="speed"
				align="top_right"
				x="-8"
				y="22"
				style_text_color="0xFFFFFF"
				style_text_font="body_lg"
			/>
			<lv_label
				name="gear_val"
				bind_text="gear"
				align="center"
				y="12"
				style_text_color="0xFFFFFF"
				style_text_font="body_lg"
				style_transform_scale_x="512"
				style_transform_scale_y="512"
			/>
			<lv_label text="GEAR" align="bottom_mid" y="-6">
				<style name="unit" />
			</lv_label>
		</lv_obj>

		<!-- RIGHT: battery + air tank pressure -->
		<lv_obj
			x="332"
			y="22"
			width="142"
			height="94"
			scrollable="false"
			style_border_color="0xFFE000"
		>
			<style name="card" />
			<lv_label text="BATTERY" align="top_mid" y="6">
				<style name="title" />
			</lv_label>
			<lv_label
				name="battery_val"
				text="13.8"
				bind_text="battery"
				align="center"
			>
				<style name="value" />
			</lv_label>
			<lv_label text="V" align="bottom_mid" y="-6">
				<style name="unit" />
			</lv_label>
		</lv_obj>

		<lv_obj
			x="332"
			y="124"
			width="142"
			height="94"
			scrollable="false"
			style_border_color="0xFF2020"
		>
			<style name="card" />
			<lv_label text="AIR TANK" align="top_mid" y="6">
				<style name="title" />
			</lv_label>
			<lv_label
				name="air_tank_val"
				text="8.0"
				bind_text="air_tank"
				align="center"
			>
				<style name="value" />
			</lv_label>
			<lv_label text="bar" align="bottom_mid" y="-6">
				<style name="unit" />
			</lv_label>
		</lv_obj>

		<!-- BOTTOM: spare slots (rename to whatever you need) -->
		<lv_obj
			x="6"
			y="226"
			width="112"
			height="88"
			scrollable="false"
			style_border_color="0xFF40C0"
		>
			<style name="card" />
			<lv_label text="AUX 1" align="top_mid" y="6">
				<style name="title" />
			</lv_label>
			<lv_label name="aux1_val" text="--" align="center" y="8">
				<style name="value" />
			</lv_label>
		</lv_obj>

		<lv_obj
			x="124"
			y="226"
			width="112"
			height="88"
			scrollable="false"
			style_border_color="0x00FFC0"
		>
			<style name="card" />
			<lv_label text="AUX 2" align="top_mid" y="6">
				<style name="title" />
			</lv_label>
			<lv_label name="aux2_val" text="--" align="center" y="8">
				<style name="value" />
			</lv_label>
		</lv_obj>

		<lv_obj
			x="242"
			y="226"
			width="112"
			height="88"
			scrollable="false"
			style_border_color="0x4060FF"
		>
			<style name="card" />
			<lv_label text="AUX 3" align="top_mid" y="6">
				<style name="title" />
			</lv_label>
			<lv_label name="aux3_val" text="--" align="center" y="8">
				<style name="value" />
			</lv_label>
		</lv_obj>

		<lv_obj
			x="360"
			y="226"
			width="112"
			height="88"
			scrollable="false"
			style_border_color="0x80FF00"
		>
			<style name="card" />
			<lv_label text="AUX 4" align="top_mid" y="6">
				<style name="title" />
			</lv_label>
			<lv_label name="aux4_val" text="--" align="center" y="8">
				<style name="value" />
			</lv_label>
		</lv_obj>
	</view>
</screen>
